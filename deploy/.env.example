# Copy to deploy/.env. Values below are deliberately non-functional.
DATABASE_URL=postgresql://USER:PASSWORD@POSTGRES_HOST:5432/farda?sslmode=require
MONGODB_URI=mongodb+srv://USER:PASSWORD@MONGODB_HOST/farda?retryWrites=true&w=majority
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=https://api.staging.example.com
CORS_ORIGINS=https://app.staging.example.com

# Image provenance. Set these from the release system before building.
BUILD_VERSION=0.0.0-staging
VCS_REF=replace-with-full-git-commit-sha
BUILD_DATE=2026-01-01T00:00:00Z

# Optional host-only development ports.
FARDA_API_PORT=8000
SMART_VIAL_API_PORT=5000
