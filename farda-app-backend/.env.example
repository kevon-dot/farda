# Example environment file. Copy to the real filename and fill in values.
# Real .env files are gitignored and MUST NOT be committed.

PORT=8000
HOST=0.0.0.0

DISABLE_HELMET=false

# Twilio configuration
TWILIO_ACCOUNT_SID="<twilio_account_sid>"
TWILIO_AUTH_TOKEN="<twilio_auth_token>"
TWILIO_PHONE_NUMBER="+1XXXXXXXXXX"
TWILIO_VERIFY_SERVICE_SID="<twilio_verify_service_sid>"

DATABASE_URL="<database_url>"

BETTER_AUTH_URL=https://your-host.example.com
BETTER_AUTH_SECRET=<generate-a-random-secret-of-at-least-32-characters>

OPENAI_API_KEY=<openai_api_key>

# Optional refill question routing. Requires in-app consent for each question.
# No model output is allowed to prescribe, change a dose, or submit an order.
FARDA_REFILL_AI_ENABLED=false
FARDA_REFILL_AI_MODEL=gpt-4o-mini
# When true, only the model classifier requires Plus/Family. Guided refill and
# clinical-safety routing remain available to every account.
FARDA_AI_REFILL_PAYWALL_ENABLED=false

# Stripe hosted web billing. Keep disabled until benefits and test products are ready.
STRIPE_BILLING_ENABLED=false
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Farda Plus: $14.99/month and $149.99/year (USD).
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_ANNUAL=
# Farda Family: $24.99/month and $249.99/year (USD).
STRIPE_PRICE_FAMILY_MONTHLY=
STRIPE_PRICE_FAMILY_ANNUAL=
# Comma-separated exact origins allowed for Checkout success/cancel and portal returns.
FARDA_BILLING_RETURN_ORIGINS=https://app.example.com

# RevenueCat native iOS/Android billing. Keep disabled until store sandbox
# validation, webhook auth, public legal/support URLs, and restore behavior are configured.
REVENUECAT_NATIVE_BILLING_ENABLED=false
REVENUECAT_MODE=sandbox
REVENUECAT_SECRET_API_KEY=
REVENUECAT_WEBHOOK_AUTH_TOKEN=
REVENUECAT_IOS_PUBLIC_API_KEY=
REVENUECAT_ANDROID_PUBLIC_API_KEY=
REVENUECAT_PLUS_ENTITLEMENT_ID=
REVENUECAT_FAMILY_ENTITLEMENT_ID=
REVENUECAT_IOS_PLUS_PRODUCT_IDS=
REVENUECAT_IOS_FAMILY_PRODUCT_IDS=
REVENUECAT_ANDROID_PLUS_PRODUCT_IDS=
REVENUECAT_ANDROID_FAMILY_PRODUCT_IDS=
REVENUECAT_ANDROID_CONTRACT_VERIFIED=false
REVENUECAT_MAX_STALE_SECONDS=86400
FARDA_TERMS_URL=
FARDA_PRIVACY_URL=
FARDA_SUPPORT_URL=

# Photon partner integration. Disabled by default; sandbox never fills medication.
# Credentials and verified patient/prescription/pharmacy links are required.
# Keep all provider credentials on this server, never in Flutter assets.
FARDA_REFILL_PROVIDER_ENABLED=false
FARDA_REFILL_PROVIDER_ENVIRONMENT=sandbox
PHOTON_CLIENT_ID=
PHOTON_CLIENT_SECRET=

# Optional routine calls. These flags never enable OTP verification by themselves.
# See src/reminders/README.md before configuring an environment.
FARDA_REMINDER_WORKER_ENABLED=false
FARDA_VOICE_ENABLED=false
FARDA_TWILIO_VOICE_FROM=
FARDA_PUBLIC_BASE_URL=https://your-host.example.com
FARDA_VOICE_ALLOWED_PREFIXES=
FARDA_VOICE_MAX_CALLS_PER_HOUR=20
