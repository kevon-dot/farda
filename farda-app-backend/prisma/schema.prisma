// Prisma schema for better-auth with phone number authentication
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String   @id @default(cuid())
  email               String?  @unique
  name                String?
  image               String?
  phoneNumber         String?  @unique
  phoneNumberVerified Boolean  @default(false)
  emailVerified       Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  accounts      Account[]
  sessions      Session[]
  prescriptions Prescription[]
  doses         Dose[]
  reminderPreference ReminderPreference?
  channelConsents ChannelConsent[]
  reminderIntents ReminderIntent[]
  deliveryAttempts DeliveryAttempt[]
  refillIntents RefillIntent[]
  refillEvents RefillEvent[]
  inventoryBalances InventoryBalance[]
  inventoryEntries InventoryEntry[]
  refillProviderLinks RefillProviderLink[]
  refillAgentReviews RefillAgentReview[]
  refillAgentRequests RefillAgentRequest[]
  circleInvitationsSent CircleInvitation[] @relation("CircleInvitationOwner")
  circleInvitationsReceived CircleInvitation[] @relation("CircleInvitationRecipient")
  circleGrantsOwned CircleGrant[] @relation("CircleGrantOwner")
  circleGrantsReceived CircleGrant[] @relation("CircleGrantRecipient")
  circleAlertsOwned CircleAlert[] @relation("CircleAlertOwner")
  circleAlertsReceived CircleAlert[] @relation("CircleAlertRecipient")
  billingCustomer BillingCustomer?
  billingSubscriptions BillingSubscription[]
  billingCheckout BillingCheckout?
}

model BillingCustomer {
  userId String @id
  stripeCustomerId String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BillingSubscription {
  id String @id @default(cuid())
  userId String
  stripeSubscriptionId String @unique
  stripeCustomerId String
  priceId String
  tier String
  status String
  currentPeriodEnd DateTime?
  cancelAtPeriodEnd Boolean @default(false)
  lastEventCreatedAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, status])
  @@index([stripeCustomerId])
}

model BillingWebhookEvent {
  stripeEventId String @id
  type String
  processedAt DateTime @default(now())
}

model BillingCheckout {
  userId String @id
  priceKey String
  stripeSessionId String? @unique
  sessionUrl String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CircleInvitation {
  id String @id @default(cuid())
  ownerId String
  recipientId String?
  recipientPhoneHash String
  recipientPhoneLast4 String
  secretHash String
  shareDoseStatus Boolean @default(true)
  shareReminders Boolean @default(true)
  expiresAt DateTime
  createdAt DateTime @default(now())
  owner User @relation("CircleInvitationOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  recipient User? @relation("CircleInvitationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  @@index([ownerId, expiresAt])
  @@index([recipientId, expiresAt])
  @@index([recipientPhoneHash, expiresAt])
  @@unique([ownerId, recipientPhoneHash])
}

model CircleGrant {
  id String @id @default(cuid())
  ownerId String
  recipientId String
  shareDoseStatus Boolean @default(true)
  shareReminders Boolean @default(true)
  acceptedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner User @relation("CircleGrantOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  recipient User @relation("CircleGrantRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  alertPolicy CircleAlertPolicy?
  alerts CircleAlert[]
  @@unique([ownerId, recipientId])
  @@index([recipientId])
}

model CircleAlertPolicy {
  grantId String @id
  enabled Boolean @default(false)
  recipientConsented Boolean @default(false)
  gracePeriodMinutes Int @default(30)
  quietHoursStart String @default("21:00")
  quietHoursEnd String @default("08:00")
  timeZone String @default("UTC")
  lastEvaluatedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  grant CircleGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  @@index([enabled, recipientConsented])
  @@index([lastEvaluatedAt])
}

model CircleAlert {
  id String @id @default(cuid())
  grantId String
  ownerId String
  recipientId String
  doseId String
  kind String @default("confirmation_not_recorded")
  scheduledFor DateTime
  state String @default("active")
  cancelReason String?
  readAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  grant CircleGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  owner User @relation("CircleAlertOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  recipient User @relation("CircleAlertRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  dose Dose @relation(fields: [doseId], references: [id], onDelete: Cascade)
  @@unique([grantId, doseId, kind])
  @@index([recipientId, state, createdAt])
  @@index([state, scheduledFor])
}

model Prescription {
  id                   String    @id @default(cuid())
  userId               String
  medicationName       String
  dosageInstructions   String?
  deviceId             String?   @unique // The vial ID from the external API
  rxNumber             String?
  storeNumber          String?
  pharmacyOrDoctorName String?
  contactDetails       String?
  dateFilled           DateTime?
  dateExpired          DateTime?
  address              String?
  labelReviewedAt      DateTime?
  archivedAt           DateTime?
  clientRequestId      String?
  requestHash          String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  doses Dose[]
  refillIntents RefillIntent[]
  inventoryBalance InventoryBalance?
  inventoryEntries InventoryEntry[]
  refillProviderLink RefillProviderLink?
  refillAgentReviews RefillAgentReview[]
  refillAgentRequests RefillAgentRequest[]
  schedules ScheduleVersion[]

  @@index([userId])
  @@unique([userId, clientRequestId])
}

model Dose {
  id             String    @id @default(cuid())
  prescriptionId String
  userId         String
  scheduledFor   DateTime
  takenAt        DateTime?
  snoozedUntil   DateTime?
  canceledAt     DateTime?
  status         String    @default("unconfirmed")
  source         String    @default("self_report")
  revision       Int       @default(0)
  scheduleVersionId String?
  mood           String?
  note           String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  reminderIntents ReminderIntent[]
  scheduleVersion ScheduleVersion? @relation(fields: [scheduleVersionId], references: [id], onDelete: SetNull)
  corrections DoseCorrection[]
  circleAlerts CircleAlert[]

  @@index([userId])
  @@index([prescriptionId])
  @@index([userId, scheduledFor])
  @@unique([scheduleVersionId, scheduledFor])
}

model ScheduleVersion {
  id String @id @default(cuid())
  prescriptionId String
  version Int
  timezone String
  recurrence String
  times Json
  startDate DateTime
  durationDays Int
  effectiveAt DateTime
  endedAt DateTime?
  createdAt DateTime @default(now())
  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  doses Dose[]
  @@unique([prescriptionId, version])
}

model DoseCorrection {
  id String @id @default(cuid())
  doseId String
  actorId String
  revision Int
  before Json
  after Json
  reason String?
  createdAt DateTime @default(now())
  dose Dose @relation(fields: [doseId], references: [id], onDelete: Cascade)
  @@unique([doseId, revision])
}

// Ownership is also checked against the session and live Dose/Prescription on
// every operation. No channel event mutates a dose confirmation.
model ReminderPreference {
  userId                String   @id
  callsEnabled          Boolean  @default(false)
  liveActivitiesEnabled Boolean  @default(false)
  timeZone              String   @default("UTC")
  quietHoursStart        String   @default("21:00")
  quietHoursEnd          String   @default("08:00")
  maxCallsPerDay         Int      @default(2)
  updatedAt             DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChannelConsent {
  id             String    @id @default(cuid())
  userId         String
  channel        String    @default("voice")
  phoneNumber    String
  wordingVersion String
  grantedAt      DateTime  @default(now())
  withdrawnAt    DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, channel, withdrawnAt])
}

model ReminderIntent {
  id           String   @id @default(cuid())
  userId       String
  doseId       String
  channel      String
  stage        String
  dueAt        DateTime
  expiresAt    DateTime
  state        String   @default("pending")
  reason       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  dose Dose @relation(fields: [doseId], references: [id], onDelete: Cascade)
  attempt DeliveryAttempt?
  @@unique([doseId, channel, stage])
  @@index([state, dueAt])
  @@index([userId, doseId])
}

model DeliveryAttempt {
  id               String    @id @default(cuid())
  intentId         String    @unique
  userId           String
  channel          String
  phoneNumber      String?
  state            String    @default("reserved")
  providerId       String?   @unique
  providerStatus   String?
  providerSequence Int       @default(-1)
  reason           String?
  startedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  intent ReminderIntent @relation(fields: [intentId], references: [id], onDelete: Cascade)
  @@index([userId, channel, createdAt])
  @@index([state, updatedAt])
}

model RefillIntent {
  id             String   @id @default(cuid())
  userId         String
  prescriptionId String
  kind           String   @default("refill")
  status         String   @default("planned")
  plannedFor     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  events RefillEvent[]
  receipt InventoryEntry?
  @@index([userId, prescriptionId])
}

model RefillEvent {
  id        String   @id @default(cuid())
  refillId  String
  userId    String
  status    String
  source    String   @default("user_report")
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  refill RefillIntent @relation(fields: [refillId], references: [id], onDelete: Cascade)
  @@index([refillId, createdAt])
}

model InventoryBalance {
  prescriptionId String   @id
  userId         String
  quantity       Int
  observedAt     DateTime
  source         String   @default("user_count")
  revision       Int      @default(1)
  updatedAt      DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model InventoryEntry {
  id             String   @id @default(cuid())
  userId         String
  prescriptionId String
  refillId       String?  @unique
  kind           String
  quantity       Int
  delta          Int
  requestKey     String
  requestHash    String
  observedAt     DateTime
  createdAt      DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  refill RefillIntent? @relation(fields: [refillId], references: [id], onDelete: Cascade)
  @@unique([userId, requestKey])
  @@index([prescriptionId, createdAt])
}

model Account {
  id                   String    @id @default(cuid())
  userId               String
  type                 String    @default("oauth")
  provider             String
  providerAccountId    String
  accessToken          String?
  refreshToken         String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  idToken              String?
  scope                String?
  password             String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
  @@map("verifications")
}

model ApiRateLimit {
  key String @id
  count Int
  expiresAt DateTime
  @@index([expiresAt])
}

// Provisioned only by a trusted operator after provider identity verification.
model RefillProviderLink {
  id String @id @default(cuid())
  userId String
  prescriptionId String @unique
  environment String
  patientId String
  providerPrescriptionId String
  pharmacyId String
  enabled Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@unique([environment, patientId, providerPrescriptionId])
}

model RefillAgentReview {
  id String @id
  userId String
  prescriptionId String
  snapshot Json
  snapshotHash String
  localRevision DateTime
  linkRevision DateTime
  expiresAt DateTime
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  request RefillAgentRequest?
  @@index([userId, prescriptionId, expiresAt])
}

// Provider facts are deliberately separate from user-report refill and supply ledgers.
model RefillAgentRequest {
  id String @id
  userId String
  prescriptionId String
  reviewId String @unique
  requestKey String
  environment String
  patientId String
  providerPrescriptionId String
  pharmacyId String
  providerOrderId String?
  status String @default("submitting")
  providerConfirmed Boolean @default(false)
  failureCode String?
  lastCheckedAt DateTime?
  refreshClaimedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  review RefillAgentReview @relation(fields: [reviewId], references: [id], onDelete: Restrict)
  @@unique([userId, requestKey])
  @@index([userId, prescriptionId, createdAt])
}
