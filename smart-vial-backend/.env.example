# No credentials belong in this file. Supply real values through secret storage.
PORT=5000
NODE_ENV=development

# Required. MongoDB must support transactions (replica set or sharded deployment).
# This is a placeholder, not a working production configuration.
MONGODB_URI=mongodb://localhost:27017/farda?replicaSet=rs0

# Required: the same PostgreSQL database used by the main API's Prisma Session/User.
DATABASE_URL=postgresql://localhost:5432/farda
CORS_ORIGINS=http://localhost:3000

# There is deliberately no DEVICE_API_KEY or JWT_SECRET fallback. Per-device
# credential digests and user-bound possession grants require trusted provisioning.
# Test integration URLs are optional and must point only at disposable local DBs:
# VIAL_TEST_MONGODB_URI=mongodb://127.0.0.1:27017/farda_test_vial?replicaSet=rs0
# VIAL_TEST_DATABASE_URL=postgresql://127.0.0.1:5432/farda_test_vial
